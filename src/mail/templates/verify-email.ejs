<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email</title>
    <style>
      @media only screen and (max-width: 600px) {
        .shell {
          width: 100% !important;
        }

        .content {
          padding: 32px 24px !important;
        }

        .button {
          display: block !important;
        }
      }
    </style>
  </head>
  <body
    style="
      margin: 0;
      background-color: #f3f6f4;
      color: #19302a;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f3f6f4"
    >
      <tr>
        <td align="center" style="padding: 36px 16px">
          <table
            role="presentation"
            class="shell"
            width="560"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              width: 560px;
              max-width: 560px;
              background-color: #ffffff;
              border: 1px solid #dce7e1;
              border-radius: 12px;
              overflow: hidden;
            "
          >
            <tr>
              <td
                style="
                  height: 8px;
                  background-color: #e47b46;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
            </tr>
            <tr>
              <td class="content" style="padding: 42px 48px 40px">
                <p
                  style="
                    margin: 0 0 28px;
                    color: #e47b46;
                    font-size: 13px;
                    font-weight: bold;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                  "
                >
                  Enodya
                </p>
                <h1
                  style="
                    margin: 0 0 16px;
                    color: #19302a;
                    font-size: 30px;
                    line-height: 1.2;
                    font-weight: 700;
                  "
                >
                  Verify your email
                </h1>
                <p
                  style="
                    margin: 0 0 28px;
                    color: #587068;
                    font-size: 16px;
                    line-height: 1.6;
                  "
                >
                  Thanks for creating your account. Please confirm your email
                  address to finish setting up your Enodya account.
                </p>
                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin: 0 0 30px"
                >
                  <tr>
                    <td
                      class="button"
                      align="center"
                      style="border-radius: 6px; background-color: #19302a"
                    >
                      <a
                        href="<%= link %>"
                        style="
                          display: inline-block;
                          padding: 15px 24px;
                          border: 1px solid #19302a;
                          border-radius: 6px;
                          color: #ffffff;
                          font-size: 15px;
                          font-weight: bold;
                          line-height: 1;
                          text-decoration: none;
                        "
                        >Verify my email</a
                      >
                    </td>
                  </tr>
                </table>
                <p
                  style="
                    margin: 0 0 10px;
                    color: #587068;
                    font-size: 13px;
                    line-height: 1.5;
                  "
                >
                  If the button does not work, copy and paste this link into
                  your browser:
                </p>
                <p
                  style="
                    margin: 0 0 30px;
                    overflow-wrap: anywhere;
                    color: #e47b46;
                    font-size: 13px;
                    line-height: 1.5;
                  "
                >
                  <a
                    href="<%= link %>"
                    style="color: #e47b46; text-decoration: underline"
                    ><%= link %></a
                  >
                </p>
                <hr
                  style="
                    margin: 0 0 22px;
                    border: 0;
                    border-top: 1px solid #e7efeb;
                  "
                />
                <p
                  style="
                    margin: 0;
                    color: #84958e;
                    font-size: 12px;
                    line-height: 1.6;
                  "
                >
                  This verification link is intended for you and may expire for
                  your security. If you did not create this account, you can
                  safely ignore this email.
                </p>
              </td>
            </tr>
          </table>
          <p
            style="
              margin: 18px 0 0;
              color: #84958e;
              font-size: 11px;
              line-height: 1.5;
            "
          >
            This is an automated message. Please do not reply.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
